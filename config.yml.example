# yaml-language-server: $schema=./config.schema.json
# Tiket Kereta Notifier - Configuration
# Copy this file and modify as needed

telegram:
  bot_token: "79481236:xxxxxx-xxxxx-x"
  chat_id: "-4947123402"

webhook:
  enabled: true
  port: 8080

# Konfigurasi browser (digunakan oleh provider bookingkai)
# Browser dijalankan tanpa --headless agar tidak terdeteksi Cloudflare
browser:
  headless: false                             # Headless mode (default: false, non-headless lebih susah dideteksi Cloudflare)
  display: ":10"                              # X display (default: ":10", sesuaikan dengan display RDP kamu)
  xauthority: "/root/.Xauthority"             # Path Xauthority (opsional, dicari otomatis jika kosong)
  chromium_path: "/usr/bin/chromium-browser"  # Path binary chromium (opsional, dicari otomatis jika kosong)

trains:
  # Satu entry per kereta, bisa punya banyak provider
  - name: BENGAWAN
    origin: LPN
    destination: CKR
    date: "2026-04-02"
    interval: 300
    notes: "Pulang kampung"
    providers:
      - traveloka
      - tiketkai

  # Wildcard: name "any" atau "*" = ambil semua kereta yang ada di rute tersebut
  # Berguna jika kamu tidak peduli kereta apa, asal ada kursi
  # Tanda petik tidak wajib: `name: any` dan `name: "any"` sama saja
  # - name: any
  #   origin: GMR
  #   destination: YK
  #   date: "2026-04-02"
  #   interval: 300
  #   providers:
  #     - traveloka

  # Filter harga: max_price = harga maksimal dalam Rupiah (0 atau tidak diisi = tanpa filter)
  # Contoh: hanya notifikasi jika harga tiket <= Rp 350.000
  # - name: BENGAWAN
  #   origin: LPN
  #   destination: CKR
  #   date: "2026-04-02"
  #   interval: 300
  #   max_price: 350000
  #   providers:
  #     - traveloka

  # Kombinasi wildcard + price filter: semua kereta di rute ini yang <= Rp 500.000
  # - name: "*"
  #   origin: GMR
  #   destination: YK
  #   date: "2026-04-02"
  #   interval: 300
  #   max_price: 500000
  #   providers:
  #     - traveloka

  # Filter jam keberangkatan: min_departure_hour dan max_departure_hour (0 = tanpa filter)
  # Hanya berlaku untuk provider bookingkai.
  # Contoh: notifikasi hanya untuk kereta yang berangkat antara jam 06:00 – 14:59
  # - name: BENGAWAN
  #   origin: LPN
  #   destination: CKR
  #   date: "2026-04-02"
  #   interval: 300
  #   min_departure_hour: 6   # minimal jam 06:00
  #   max_departure_hour: 14  # maksimal jam 14:59
  #   providers:
  #     - bookingkai

  # Contoh: kereta dengan provider yang butuh proxy
  # - name: ARGO DWIPANGGA
  #   origin: GMR
  #   destination: YK
  #   date: "2026-02-17"
  #   interval: 300
  #   providers:
  #     - traveloka
  #     - name: tiketcom
  #       proxy_url: "socks5h://127.0.0.1:40000"
  #     - name: bookingkai
  #       proxy_url: "socks5://127.0.0.1:40000"

  # Backward compatible: format lama (single provider) masih bisa dipakai
  # - name: GAJAYANA
  #   origin: BD
  #   destination: SGU
  #   date: "2026-02-18"
  #   provider: tiketcom
  #   proxy_url: "socks5h://127.0.0.1:40000"
  #   interval: 120

# yaml-language-server: $schema=./config.schema.json
# Tiket Kereta Notifier - Configuration
# Copy to config.yml; fill credentials and replace ALL example travel dates.
# Docker: keep browser.headless true; see README for config file permissions.

telegram:
  bot_token: "YOUR_BOT_TOKEN"
  # Numeric chat ID; only this chat may run commands. All members can if a group.
  chat_id: "YOUR_CHAT_ID"

webhook:
  # Polling by default. Webhook uses cloudflared and an automatic secret token.
  enabled: false
  port: 8080

# Dipakai Camoufox (Firefox), fallback BookingKAI. Key lama chromium_path &
# user_data_dir sudah dihapus — kalau masih ada di config kamu, diabaikan.
browser:
  headless: true

trains:
  # Satu entry per kereta, bisa punya banyak provider
  - name: BENGAWAN
    origin: LPN
    destination: CKR
    date: "2026-04-02"
    interval: 300
    notes: "Pulang kampung"
    providers:
      - traveloka
      - tiketkai

  # Wildcard: name "any" atau "*" = ambil semua kereta yang ada di rute tersebut
  # Berguna jika kamu tidak peduli kereta apa, asal ada kursi
  # Tanda petik tidak wajib: `name: any` dan `name: "any"` sama saja
  # - name: any
  #   origin: GMR
  #   destination: YK
  #   date: "2026-04-02"
  #   interval: 300
  #   providers:
  #     - traveloka

  # Filter harga: max_price = harga maksimal dalam Rupiah (0 atau tidak diisi = tanpa filter)
  # Contoh: hanya notifikasi jika harga tiket <= Rp 350.000
  # - name: BENGAWAN
  #   origin: LPN
  #   destination: CKR
  #   date: "2026-04-02"
  #   interval: 300
  #   max_price: 350000
  #   providers:
  #     - traveloka

  # Kombinasi wildcard + price filter: semua kereta di rute ini yang <= Rp 500.000
  # - name: "*"
  #   origin: GMR
  #   destination: YK
  #   date: "2026-04-02"
  #   interval: 300
  #   max_price: 500000
  #   providers:
  #     - traveloka

  # Filter jam keberangkatan: min_departure_hour dan max_departure_hour (0 = tanpa filter)
  # Hanya berlaku untuk provider bookingkai.
  # Contoh: notifikasi hanya untuk kereta yang berangkat antara jam 06:00 – 14:59
  # - name: BENGAWAN
  #   origin: LPN
  #   destination: CKR
  #   date: "2026-04-02"
  #   interval: 300
  #   min_departure_hour: 6   # minimal jam 06:00
  #   max_departure_hour: 14  # maksimal jam 14:59
  #   providers:
  #     - bookingkai

  # Contoh: kereta dengan provider yang butuh proxy
  # Docker + proxy di host: ganti 127.0.0.1 dengan host.docker.internal.
  # Proxy harus menerima koneksi dari bridge Docker; jangan buka ke publik.
  # - name: ARGO DWIPANGGA
  #   origin: GMR
  #   destination: YK
  #   date: "2026-02-17"
  #   interval: 300
  #   providers:
  #     - traveloka
  #     - name: tiketcom
  #       proxy_url: "socks5h://127.0.0.1:40000"
  #     - name: bookingkai
  #       proxy_url: "socks5://127.0.0.1:40000"

  # Backward compatible: format lama (single provider) masih bisa dipakai
  # - name: GAJAYANA
  #   origin: BD
  #   destination: SGU
  #   date: "2026-02-18"
  #   provider: tiketcom
  #   proxy_url: "socks5h://127.0.0.1:40000"
  #   interval: 120

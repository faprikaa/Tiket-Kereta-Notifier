# yaml-language-server: $schema=./config.schema.json
# Tiket Kereta Notifier - Configuration
# Copy this file and modify as needed

telegram:
  bot_token: "79481236:xxxxxx-xxxxx-x"
  chat_id: "-4947123402"

webhook:
  enabled: true
  port: 8080

trains:
  # Satu entry per kereta, bisa punya banyak provider
  - name: BENGAWAN
    origin: LPN
    destination: CKR
    date: "2026-04-02"
    interval: 300
    notes: "Pulang kampung"
    providers:
      - traveloka
      - tiketkai

  # Contoh: kereta dengan provider yang butuh proxy

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tiket Kereta Notifier Config",
  "type": "object",
  "required": ["telegram", "trains"],
  "properties": {
    "telegram": {
      "type": "object",
      "required": ["bot_token", "chat_id"],
      "properties": {
        "bot_token": {
          "type": "string",
          "description": "Telegram bot token from @BotFather"
        },
        "chat_id": {
          "type": "string",
          "description": "Telegram chat ID untuk notifikasi"
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable webhook mode (requires cloudflared)"
        },
        "port": {
          "type": "integer",
          "default": 8080,
          "description": "Port untuk webhook server"
        }
      }
    },
    "trains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "origin", "destination", "date"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nama kereta yang ingin dimonitor"
          },
          "origin": {
            "type": "string",
            "description": "Kode stasiun asal (contoh: GMR, BD, LPN)"
          },
          "destination": {
            "type": "string",
            "description": "Kode stasiun tujuan (contoh: YK, SGU, CKR)"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Tanggal keberangkatan (format: YYYY-MM-DD)"
          },
          "interval": {
            "type": "integer",
            "default": 300,
            "minimum": 60,
            "description": "Interval check dalam detik (minimum 60)"
          },
          "notes": {
            "type": "string",
            "description": "Catatan opsional, ditampilkan di /list dan notifikasi"
          },
          "max_price": {
            "type": "integer",
            "minimum": 0,
            "description": "Harga maksimal tiket dalam Rupiah (0 atau tidak diisi = tanpa filter)"
          },
          "min_departure_hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "description": "Jam keberangkatan minimum (0-23). Hanya untuk provider bookingkai. 0 = tanpa filter."
          },
          "max_departure_hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "description": "Jam keberangkatan maksimum (0-23). Hanya untuk provider bookingkai. 0 = tanpa filter."
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "description": "Daftar provider (string atau object dengan proxy_url)",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["tiketkai", "traveloka", "tiketcom", "bookingkai"],
                  "description": "Provider name (tanpa proxy)"
                },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": ["tiketkai", "traveloka", "tiketcom", "bookingkai"],
                      "description": "Provider name"
                    },
                    "proxy_url": {
                      "type": "string",
                      "description": "SOCKS5 proxy URL (contoh: socks5h://127.0.0.1:40000)"
                    }
                  }
                }
              ]
            }
          },
          "provider": {
            "type": "string",
            "enum": ["tiketkai", "traveloka", "tiketcom", "bookingkai"],
            "description": "[DEPRECATED] Gunakan 'providers' array. Single provider untuk backward compat."
          },
          "proxy_url": {
            "type": "string",
            "description": "[DEPRECATED] Gunakan providers array. SOCKS5 proxy URL."
          }
        }
      }
    }
  }
}
